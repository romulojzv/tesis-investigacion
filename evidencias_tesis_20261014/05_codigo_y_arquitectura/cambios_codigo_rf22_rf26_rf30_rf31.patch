+      // Intentar tocar opci├│n A u otra alternativa
+      await tester.tap(find.text('Opci├│n A1'));
+      await tester.pumpAndSettle();
+
+      // La llamada al servicio no debe repetirse
+      expect(mock.responderCalls.length, 1);
+    });
+
+    testWidgets('Respuesta incorrecta muestra banner explicativo y revela alternativa correcta', (tester) async {
+      final mock = MockQuizFeedbackServiceImpl();
+      await tester.pumpWidget(crearWidgetPrueba(mock));
+      await tester.pumpAndSettle();
+
+      // Seleccionar opci├│n incorrecta (A = ├¡ndice 0)
+      await tester.tap(find.text('Opci├│n A1'));
+      await tester.pumpAndSettle();
+      await tester.tap(find.text('Comprobar respuesta'));
