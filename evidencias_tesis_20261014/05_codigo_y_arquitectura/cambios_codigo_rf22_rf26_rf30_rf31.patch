+      // Si retrocede a la 1, debe ver que ya est├í respondida y con su feedback
+      await tester.tap(find.text('Anterior'));
+      await tester.pumpAndSettle();
+
+      expect(find.text('Pregunta 1 de 5'), findsOneWidget);
+      expect(find.text('┬íCorrecto! ­ƒîƒ'), findsOneWidget);
+      expect(find.text('Explicaci├│n guardada'), findsOneWidget);
+    });
+
+    testWidgets('Finalizaci├│n: al responder la pregunta 5 permite ver el resultado final', (tester) async {
+      final mock = MockQuizFeedbackServiceImpl();
