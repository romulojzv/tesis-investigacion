+    .select('id')
+    .eq('codigo_aula', 'STG4')
+    .maybeSingle();
+
+  let aulaId = aulaExistente?.id;
+  if (!aulaId) {
+    const { data: nuevaAula } = await adminClient.from('aulas').insert({
+      nombre: '4to Grado Staging',
+      codigo_aula: 'STG4',
+      docente_id: docente.id,
+    }).select('id').single();
+    aulaId = nuevaAula!.id;
+  }
+
+  await adminClient.from('aula_estudiantes').upsert([
