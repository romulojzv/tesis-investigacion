+      mock.customStartResponse = QuizStartResponse(
+        intentoId: 'intento-reanudado',
+        estado: 'en_progreso',
+        preguntas: List.generate(
+          5,
+          (i) => QuizQuestion(
+            numero: i + 1,
+            pregunta: '┬┐Pregunta ${i + 1}?',
+            opciones: ['A', 'B', 'C', 'D'],
+            nivelComprension: i == 0 ? 'literal' : 'inferencial',
+          ),
+        ),
+        retroalimentaciones: [
+          const QuizQuestionResult(
+            numero: 1,
+            pregunta: '┬┐Pregunta 1?',
+            opciones: ['A', 'B', 'C', 'D'],
+            indiceSeleccionado: 1,
+            indiceCorrecto: 1,
+            esCorrecta: true,
+            explicacion: 'Explicaci├│n guardada',
