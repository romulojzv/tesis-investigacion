+      expect(mock.responderCalls.first.indiceSeleccionado, 1);
+
+      // Verificar retroalimentaci├│n inmediata en la UI
+      expect(find.text('┬íCorrecto! ­ƒîƒ'), findsOneWidget);
+      expect(find.text('┬íExcelente! La historia lo menciona con claridad.'), findsOneWidget);
+      expect(find.text('Lee esta explicaci├│n antes de continuar.'), findsOneWidget);
+
+      // El bot├│n ahora debe ser "Siguiente"
+      expect(find.text('Siguiente'), findsOneWidget);
+    });
+
+    testWidgets('Inmutabilidad: respuesta confirmada bloquea cambios de selecci├│n', (tester) async {
+      final mock = MockQuizFeedbackServiceImpl();
+      await tester.pumpWidget(crearWidgetPrueba(mock));
+      await tester.pumpAndSettle();
+
+      // Seleccionar y confirmar opci├│n B
+      await tester.tap(find.text('Opci├│n B1'));
+      await tester.pumpAndSettle();
+      await tester.tap(find.text('Comprobar respuesta'));
+      await tester.pumpAndSettle();
+
+      expect(mock.responderCalls.length, 1);
