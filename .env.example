# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — CUENTOS MÁGICOS
# Instrucciones:
# 1. Copia este archivo como .env (el cual está estrictamente ignorado por git).
# 2. Reemplaza los valores de ejemplo por tus credenciales de Staging o Local.
# 3. NUNCA confirmes ni publiques archivos .env con credenciales reales.
# ==============================================================================

# Conexión Supabase (Local o Staging)
# Local: http://127.0.0.1:54321 | Staging: https://<tu-project-ref>.supabase.co
SUPABASE_URL=https://tu-proyecto-staging.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta_aqui

# Credenciales de Pruebas Automatizadas en Staging (Observación 18 y 19)
STAGING_TEST_PASSWORD=PasswordSeguroEjemplo2026!
STAGING_TEST_PIN=123456
STAGING_DOCENTE_EMAIL=docente.test@example.com
STAGING_ESTUDIANTE1_EMAIL=estudiante1.test@example.com
STAGING_ESTUDIANTE2_EMAIL=estudiante2.test@example.com

# Cuentas Piloto / Demostración
DOCENTE_NOMBRE=Profesor Demo
DOCENTE_EMAIL=docente.piloto@cuentosmagicos.edu.pe
DOCENTE_PASSWORD=DocentePasswordSeguro2026!
DEMO_CODIGO_ACCESO=DEMO26
DEMO_ESTUDIANTE_PIN=123456
DEMO_DOCENTE_PASSWORD=DocentePasswordSeguro2026!

# Aula Piloto
AULA_NOMBRE=4to Grado A
AULA_CODIGO=4A26

# Control de Pruebas Controladas de IA (Prevenir costos accidentales)
# Cambiar a "SI" únicamente al ejecutar deliberadamente la prueba controlada
AUTORIZO_TEST_GEMINI=NO
